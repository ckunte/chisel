{% from 'site_settings.jinja2' import site_title, site_author, site_url -%}
{
  "version" : "https://jsonfeed.org/version/1.1",
  "user_comment" : "This feed lets you know whenever a new note is published on this site. Copy the following URL -- {{ site_url }}/notes.json -- and add it to your feed reader.",
  "title" : "{{ site_author }}",
  "description" : "A personal weblog by {{ site_author }}",
  "home_page_url" : "{{ site_url }}/notes",
  "feed_url" : "{{ site_url }}/notes.json",
  "author" : {
    "name" : "{{ site_author }}",
    "url" : "{{ site_url }}"
  },
  "items": [
  {%- for entry in entries %}
    {
      "title": {{ entry.title|e|tojson }},
      "date_published": "{{ entry.year }}-{{ entry.month }}-{{ entry.day }}T{{ entry.hour }}:{{ entry.minute }}:00+08:00",
      "url": "{{ site_url}}/{{ entry.url }}",
      "author" : {
        "name" : "{{ site_author }}"
      },
      "id" : "{{ site_url}}/{{ entry.url }}",
      "content_html" : {{ entry.content|e|tojson }}
    }{%if not loop.last %},{%endif%}
  {%- endfor %}    
  ]
}