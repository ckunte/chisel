{% extends "base.j2" %}
{%- block title %}: {{ entry.title }}{%- endblock %}
{%- block og %}{# Open Graph #}
<meta name="description" content="{{ entry.content|truncate(100)|striptags }}" />
{%- endblock %}
{%- block post %}
  {%- set curr = entry.url %}
  {%- set total = entries | count %}	
<article>
<h1>{{ entry.title | e }}</h1>
<time datetime="{{ entry.feed_date }}">{{ entry.nice_date }}</time>
{{ entry.content }}
</article>
{% include 'nav.j2' %}
{%- endblock %}
