<article>
{%- from 'sitesettings.j2' import latest -%}
{%- for entry in entries %}
{%- if loop.index < latest + 1 %}
<h1>{{ entry.title | e }}</h1>
<time datetime="{{ entry.feed_date }}">
{{ entry.nice_date }}, 
{{ entry.content | wordcount // 250 + 1 }} min read.
<a title="Permalink to '{{ entry.title | e }}'" href="/{{ entry.url }}">#</a>
</time>
{{ entry.content }}
{%- endif %}
{%- endfor %}
</article>
