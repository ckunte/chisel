{% extends "base.j2" %}
{% from 'sitesettings.j2' import latest -%}
{%- block title %}{%- endblock %}
{%- block feed %}
<link rel="alternate" type="application/feed+json" title="JSON feed" href="{{ site_url }}/feed.json" />
{%- endblock %}
{%- block og %} {# Open Graph #}
<meta name="description" content="{{ site_author }}'s homepage" />
{%- endblock %}
{%- block post %}
{% include 'latest.j2' %}
{% include 'archive.j2' %} {# list excluding the latest #}
<footer>
  <span>{#<a title="Subscribe to {{ site_title }} feed for the latest" href="/feed.json">feed</a>#}</span>
  <span>produced by <a href="https://github.com/ckunte">{{ site_author }}</a></span>
</footer>
{% endblock %}
{%- block rent %}
<div id="r">
{% include 'rent.md' %}
</div>
{%- endblock %}{# 
  cat home.css | openssl dgst -sha384 -binary | openssl base64 -A
#}