{% from 'site_settings.jinja2' import site_title, site_author, site_url, last -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">

  <title>{{ site_title }}</title>
  <link href="{{ site_url }}" />
  <link rel="self" href="{{ site_url }}/rss.xml" />
  {%- for entry in entries -%}
  {%- if loop.index < last + 1 %}
  <updated>{{ entry.feed_date }}</updated> 
  {%- endif -%}
  {%- endfor %}
  <id>{{ site_url }}/rss.xml</id>
  {% for entry in entries %}
  <entry>
    <title>{{ entry.title | e }}</title>
    <link href="{{ site_url }}/w#{{ entry.epoch | int }}" />
    <id>{{ site_url }}/w#{{ entry.epoch | int }}</id>
    <updated>{{ entry.feed_date }}</updated>
    <author>
      <name>{{ site_author }}</name>
      <uri>{{ site_url }}/</uri>
    </author>
    <content type="html" xml:base="{{ site_url }}" xml:lang="en">
{%- filter indent(width=4) %}
{{ entry.content | e }}{#{{ "<hr><small><i>This is an rss-only gig.</i></small>" | e }}#}
{%- endfilter %}
    </content>
  </entry>
{% endfor %}
</feed>